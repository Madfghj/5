# Client variables are public. For web preview leave empty.
# For a native build set your deployed HTTPS API root, then run build:mobile + cap:sync.
VITE_API_URL=

# Wrangler local server values are in wrangler.json.
# Optional OAuth secrets go in .dev.vars locally and Sites environment secrets in production.
# Never put secrets in VITE_* or commit .dev.vars.