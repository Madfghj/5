{
  "name": "opencalendar-space-online",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "tsc -b && vite build && node scripts/build-cloud.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "start": "node scripts/start.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "dev:cloud": "wrangler dev --config wrangler.json --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state --inspector-port 0",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.json --persist-to .wrangler/state",
    "dev:ui": "vite --host 127.0.0.1 --port 5174",
    "test:cloud": "node --test tests/cloud.test.mjs",
    "check:android": "node scripts/ci-native-check.mjs android",
    "check:ios": "node scripts/ci-native-check.mjs ios",
    "check:auth": "node scripts/auth-readiness.mjs --origin https://opencalendar-space-live.optimisticraccoon.chatgpt.site",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dev:desktop": "node scripts/build-desktop.mjs --dev",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@noble/hashes": "^2.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "^4.92.0"
  },
  "packageManager": "pnpm@11.25.0"
}
