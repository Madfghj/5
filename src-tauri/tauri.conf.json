{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCalendar",
  "version": "0.3.3",
  "identifier": "space.opencalendar.app",
  "build": {
    "beforeDevCommand": "pnpm run dev:desktop",
    "devUrl": "http://127.0.0.1:5176",
    "beforeBuildCommand": "pnpm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenCalendar",
        "create": false,
        "url": "index.html",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#f7f6f2",
        "theme": "Light"
      }
    ],
    "security": {
      "capabilities": [
        "main-local"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://opencalendar-space-live.optimisticraccoon.chatgpt.site; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5176 ws://127.0.0.1:5176 https://opencalendar-space-live.optimisticraccoon.chatgpt.site; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Shared calendar for groups",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "space.opencalendar.app"
        ]
      }
    }
  }
}
